# Machine-local data and OS metadata.
.local/
.DS_Store
Thumbs.db
Desktop.ini

# Machine-local credentials and coding-agent state.
/.aws/
/.azure/
/.gcloud/
/.codex/

# Media accidentally placed next to the source tree.
/*.mp4
/*.mov
/*.mkv

# Real environment values stay local; examples contain dummy values only.
.env
.env.*
!.env.example
!.env.*.example

# Python environments, build output, and caches.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# Local inputs and generated remote-data caches/results (never source code).
/input/
/data/
/outputs/
/reports/
/artifacts/
/logs/

# Interrupted writes; no blanket ignores for lockfiles or shared configuration.
*.part
*.tmp

# Keep pyproject.toml, lockfiles, config/, docs/, and intentional test fixtures tracked.
